# 服务端口
PORT=3000

# SQLite 数据库路径（Docker 部署通常设为 /app/data/vocabulary.db）
# DB_PATH=data/vocabulary.db

# 是否允许注册（设为 false 则只能登录，不能注册新账号）
# ALLOW_REGISTRATION=false

# 管理员账号（启动时自动创建或提升为管理员）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-secure-password

# API Key 加密主密钥（生产环境强烈建议设置；未设置则 Key 明文存库）
# KEY_ENCRYPTION_SECRET=your-long-random-secret-at-least-32-chars

# ── 关于 AI / OCR ──
# API Key、模型、OCR 引擎在 Web 端「模型」按用户配置（user_ai_provider_configs）。
# 调用经 AI 网关；Token 统计与每日上限在「Token 消耗」页面设置。
