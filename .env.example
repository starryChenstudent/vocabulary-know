# 百炼 DashScope（推荐，手写识别效果更好）
DASHSCOPE_API_KEY=
# 单词表识别建议用 qwen-vl-plus；qwen-vl-ocr-latest 容易漏掉英文列
DASHSCOPE_VISION_MODEL=qwen-vl-plus
# 识别只有词性+中文时，自动用此模型二次结构化识别
# DASHSCOPE_STRUCTURE_MODEL=qwen-vl-plus
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI 兼容（可选）
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini

# OCR 引擎：auto | vision | tesseract
OCR_ENGINE=auto

# 服务端口
PORT=3000

# 是否允许注册（设为 false 则只能登录，不能注册新账号）
# ALLOW_REGISTRATION=false
