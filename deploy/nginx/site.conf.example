# 示例：复制到服务器 /etc/nginx/conf.d/ 或 sites-available/ 后按需修改域名与端口。
# 自定义 502/503/504 页面（更新、重启 Docker 时用户会看到）

server {
    listen 80;
    server_name your-domain.com;

    # 错误页 HTML 所在目录（把 deploy/nginx/error-pages/ 拷到服务器此路径）
    root /var/www/vocabulary-know/error-pages;

    location = /favicon.png {
        alias /var/www/vocabulary-know/public/favicon.png;
    }

    location = /apple-touch-icon.png {
        alias /var/www/vocabulary-know/public/apple-touch-icon.png;
    }

    location = /logo.png {
        alias /var/www/vocabulary-know/public/logo.png;
    }

    error_page 502 503 504 /502.html;

    location = /502.html {
        internal;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
    }
}
